# SiteForge environment. Copy to `.env` for local development; on Vercel add each variable under
# Project → Settings → Environment Variables (Production + Preview). Validated at startup by
# src/config/env.ts — a misconfigured production deploy fails fast with every problem listed.
# Nothing sensitive may be prefixed NEXT_PUBLIC_ (those values are shipped to the browser).

# ---- Platform ----------------------------------------------------------------------------------
# Root host of the platform. Tenant sites live on *.ROOT_DOMAIN plus custom domains.
# Dev: localhost (tenants at http://<slug>.localhost:3000). Prod: your bare domain, e.g. siteforge.pk
ROOT_DOMAIN=localhost
# Must be identical to ROOT_DOMAIN (the browser-side copy).
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Optional. Canonical origin of the marketing site for metadataBase / sitemap / JSON-LD when it differs
# from https://ROOT_DOMAIN (e.g. https://www.siteforge.pk). No trailing slash.
# NEXT_PUBLIC_SITE_URL=

# Signs session cookies, upload-confirm tokens and public order-page tokens (HMAC-SHA256).
# 32+ chars, not a placeholder: `openssl rand -base64 48`. ROTATING IT LOGS EVERYONE OUT (session hashes
# are keyed with it) and invalidates every outstanding order/upload link.
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars

# ---- Supabase Postgres -------------------------------------------------------------------------
# Runtime: transaction pooler (port 6543). Keep `pgbouncer=true&connection_limit=1` for serverless.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Every Prisma CLI command (migrate dev/deploy, db push, db seed, studio, validate) — not only migrations: direct /
# session connection (port 5432). prisma.config.ts uses it when set and falls back to DATABASE_URL; the runtime
# client (src/server/db.ts) never reads it.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional tuning. Pool size per server instance (default 3 on Vercel, 10 locally, max 50).
# DB_POOL_MAX=
# Optional, dev only: set to 1 to print every Prisma query.
# DB_LOG_QUERIES=

# ---- Cloudflare R2 (media) ----------------------------------------------------------------------
# All-or-nothing: set all five or none. With none set, uploads are disabled with a clear admin message.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=siteforge-media
# Public bucket URL or the custom domain mapped to the bucket (https in production; no query/fragment).
# Also feeds next.config.ts images.remotePatterns.
R2_PUBLIC_URL=https://media.siteforge.pk

# ---- Notifications (optional) -------------------------------------------------------------------
# Resend API key for lead / order emails to tenant owners. NOTIFY_FROM_EMAIL is required when set;
# either a bare address or `Name <address>` (the sending domain must be verified in Resend).
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=SiteForge <no-reply@siteforge.pk>

# ---- Scheduled maintenance + detailed health ----------------------------------------------------
# Shared secret (>= 16 chars, `openssl rand -hex 24`). Vercel Cron sends it as `Authorization: Bearer …`
# to /api/cron/maintenance (see vercel.json: daily 03:00 UTC = 08:00 PKT). The same header unlocks the
# detailed /api/health body (build + database check). Unset → cron route answers 404, health stays minimal.
CRON_SECRET=

# ---- Observability (optional) -------------------------------------------------------------------
# Minimum level for the structured JSON logger (src/lib/log.ts): debug | info | warn | error.
# Default: info (debug in development).
# LOG_LEVEL=
# Reserved for the Sentry SDK (not installed yet; see src/instrumentation.ts for the two-line hook-up).
# SENTRY_DSN=

# ---- Seed (`npm run db:seed`, local / one-off only — never needed on Vercel) --------------------
# First super admin. Without SEED_SUPER_PASSWORD a random one is generated and printed ONCE.
# SEED_SUPER_USERNAME=admin
# SEED_SUPER_EMAIL=you@siteforge.pk
# SEED_SUPER_PASSWORD=
# Demo websites (one per template, `demo-<templateId>.<ROOT_DOMAIN>`, owner login `demo`).
# SEED_DEMO_PASSWORD=           # owner password for all demo sites (generated + printed once when unset)
# SEED_DEMO_TEMPLATES=all       # all | first | comma list of template ids and/or category keys (pizza-01,law)
# SEED_DEMO_TENANTS=1           # 0 skips demo websites entirely (production platforms)

# ---- Set automatically (do not add) -------------------------------------------------------------
# NODE_ENV, VERCEL, VERCEL_ENV, VERCEL_REGION, VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF are provided by
# Vercel / Next.js and read by the proxy, health route and logger.
